package main

import (
	"fmt"
	"strconv"
)

//"1000,1h30m"
//map[string]string

func sprintStr() func(string) (string, int) {

	row := ""

	return func(x string) (string, int) {
		var m int

		if x != "," {
			row = row + x
			return row, m
		}

		if m != 0 {
			return row, m

		}

		m, _ = strconv.Atoi("row")
		row = ""
		return row, m
	}
}

func main() {

	text := "1000,1h30m" + ","
	peer := sprintStr()

	for i := 0; i < len(text); i++ {

		s, m := peer(string(text[i]))
	}

	fmt.Println(s, m)
}

